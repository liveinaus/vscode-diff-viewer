{
	"name": "better-diff-viewer",
	"displayName": "Better Diff Viewer",
	"description": "View Git diff in a colorful page ...",
	"icon": "images/extension-icon.png",
	"publisher": "SamWang",
	"author": "Sam Wang",
	"version": "1.1.4",
	"engines": {
		"vscode": "^1.71.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onLanguage:diff"
	],
	"main": "./dist/main.js",
	"contributes": {
		"viewsContainers": {
			"panel": [
				{
					"id": "bdv-view",
					"title": "Better Diff View",
					"icon": "test.icon"
				}
			]
		},
		"views": {
			"bdv-view": [
				{
					"type": "webview",
					"id": "better-diff-viewer.bdvView",
					"name": "Diff View"
				}
			]
		},
		"configuration": {
			"title": "Better Diff Viewer",
			"properties": {
				"better-diff-viewer.maxDiffLinesPerFile": {
					"type": "number",
					"default": 3000,
					"minimum": 100,
					"description": "Maximum lines shown per file in the diff view. Files exceeding this limit are truncated. Binary patch data is always excluded regardless of this setting."
				}
			}
		},
		"commands": [
			{
				"command": "better-diff-viewer.viewDiffFile",
				"title": "Better-diff-viewer: View Diff File (.diff or .patch)"
			},
			{
				"command": "better-diff-viewer.viewRepoGitDiff",
				"title": "Better-diff-viewer: View Uncommitted Changes"
			},
			{
				"command": "better-diff-viewer.viewStagedChanges",
				"title": "Better-diff-viewer: View Changes to be Committed"
			},
			{
				"command": "better-diff-viewer.viewGitDiffForFile",
				"title": "Better-diff-viewer: View Git Diff for current file"
			},
			{
				"command": "better-diff-viewer.viewCustomDiffFromCmd",
				"title": "Better-diff-viewer: View Diff from a custom command"
			},
			{
				"command": "better-diff-viewer.viewChangesInCommit",
				"title": "Better-diff-viewer: View Changes in a commit"
			},
			{
				"command": "better-diff-viewer.viewChangesBetweenCommits",
				"title": "Better-diff-viewer: View Changes between commits"
			},
			{
				"command": "better-diff-viewer.toggleFileDiff",
				"title": "Better-diff-viewer: Toggle File Diff",
				"icon": {
					"light": "./images/extension-icon.png",
					"dark": "./images/extension-icon.png"
				}
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "better-diff-viewer.toggleFileDiff",
					"group": "navigation"
				}
			]
		}
	},
	"repository": "https://github.com/liveinaus/vscode-diff-viewer",
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "vscode-test",
		"deploy": "vsce publish",
		"deploy:ovsx": "ovsx publish"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.41",
		"@types/uuid": "^9.0.8",
		"@types/vscode": "^1.120.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^2.32.0",
		"ovsx": "^0.9.5",
		"eslint": "^8.57.1",
		"ts-loader": "^9.6.0",
		"typescript": "^5.9.3",
		"webpack": "^5.107.2",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"uuid": "^9.0.1"
	}
}
